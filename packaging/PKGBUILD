# Maintainer: Alfredo Gore <alfredo dot gore at gmail dot com>
pkgname=stamp-usb
pkgver=0.1.0
pkgrel=1
pkgdesc="Quickshell application that writes disk images to USB sticks"
arch=('any')
url="https://github.com/varrtto/stamp"
license=('MIT')
depends=('quickshell' 'polkit' 'file')
optdepends=('udisks2: power off the stick if eject cannot')
source=("$pkgname-$pkgver.tar.gz::https://github.com/varrtto/stamp/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('5b1112122c6ce389305fef14013c3a43bdbbe25d5e17e60192d2b96edf857786')

package() {
  cd "stamp-$pkgver"
  install -Dm644 shell.qml -t "$pkgdir/usr/share/stamp-usb"
  install -Dm644 ActionButton.qml -t "$pkgdir/usr/share/stamp-usb"
  install -Dm755 flash.sh -t "$pkgdir/usr/share/stamp-usb"
  install -Dm755 stamp-usb "$pkgdir/usr/bin/stamp-usb"
  install -Dm644 stamp-usb.desktop "$pkgdir/usr/share/applications/stamp-usb.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
